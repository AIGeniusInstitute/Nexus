# Nexus 部署环境变量模板
# 用法：cp .env.example .env 后填入真实值（.env 不入 git）。
# 红线：NEXUS_MODEL_KEY 仅从环境读取，严禁硬编码进脚本/镜像/记忆。

# ---- Postgres ----
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus
PG_PORT=5435

# ---- Nexus 控制面 ----
NEXUS_PORT=8765
# JWT 签名密钥：生产必须改。可用 `openssl rand -hex 32` 生成。
NEXUS_JWT_SECRET=change-me-to-a-long-random-secret
# 并发 driver 池大小（同时 in-flight turn 上限）
NEXUS_POOL_SIZE=4

# ---- 管理员（首次启动 seed；之后改密码需进 DB）----
NEXUS_ADMIN_EMAIL=admin@nexus.local
NEXUS_ADMIN_PASSWORD=admin123

# ---- 模型上游（真实联调用；留空则走 mock，turn 仍可完成）----
# dashscope 兼容端点示例：https://dashscope.aliyuncs.com/compatible-mode/v1
NEXUS_UPSTREAM_MODEL_URL=
NEXUS_MODEL_KEY=
NEXUS_MODEL=deepseek-v4-pro
NEXUS_EMBED_MODEL=text-embedding-v3

# ---- 调试 ----
# SIMULATE_APPROVAL=1 时 driver 注入合成审批（无需真实模型即可验证 HITL/学习闭环）
NEXUS_SIMULATE_APPROVAL=0
RUST_LOG=nexus_control=info
